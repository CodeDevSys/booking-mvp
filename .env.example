# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (PostgreSQL — multi-tenant SaaS)
DATABASE_URL=postgresql://user:password@localhost:5432/nexora

# Stripe Billing (recurring subscriptions + 14-day trial)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create recurring monthly EUR prices in Stripe Dashboard, then paste Price IDs:
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Email (magic link auth + booking link after payment)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=NEXORA <noreply@nexora.app>

# Booking MVP app URL (sent to customers after Stripe checkout)
BOOKING_APP_URL=https://booking-mvp.onrender.com
NEXT_PUBLIC_BOOKING_APP_URL=https://booking-mvp.onrender.com
